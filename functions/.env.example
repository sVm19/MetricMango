# Missing/undefined values default to false in backend runtime guards.
BILLING_RAZORPAY_ENABLED=false
BILLING_LEMON_SQUEEZY_ENABLED=false

# Shopify webhooks
# Used to verify `X-Shopify-Hmac-Sha256` (HMAC of the raw request body).
SHOPIFY_WEBHOOK_SECRET=
# Shopify app install / OAuth (used during onboarding connect step)
# SHOPIFY_APP_API_KEY: public app key from Shopify Partners dashboard.
# SHOPIFY_APP_URL: your app base URL (example: https://app.metricmango.com).
# SHOPIFY_REDIRECT_URI: OAuth callback URL (optional; defaults to <SHOPIFY_APP_URL>/shopify/callback).
# SHOPIFY_SCOPES: comma-separated OAuth scopes (defaults to read_orders,read_products).
SHOPIFY_APP_API_KEY=
SHOPIFY_APP_URL=
SHOPIFY_REDIRECT_URI=
SHOPIFY_SCOPES=read_orders,read_products

# Onboarding admin/debug reset (disabled by default)
# When enabled, call POST /onboarding/reset with:
# - Authorization: Bearer <Firebase ID token>
# - x-debug-reset-token: <ONBOARDING_DEBUG_RESET_TOKEN>
ONBOARDING_DEBUG_RESET_ENABLED=false
ONBOARDING_DEBUG_RESET_TOKEN=

# Email alerts (Resend)
# RESEND_API_KEY: server-side key for sending emails via Resend.
RESEND_API_KEY=
# RESEND_FROM: "From" identity shown to recipients (example: Metric Mango <alerts@metricmango.com>).
RESEND_FROM=alerts@metricmango.store

# Billing (Lemon Squeezy)
# LEMON_SQUEEZY_STORE_ID: your Lemon Squeezy store id (used for API calls if/when needed).
LEMON_SQUEEZY_STORE_ID=
# LEMON_SQUEEZY_API_KEY: server-side API key (do not expose to frontend).
LEMON_SQUEEZY_API_KEY=
# LEMON_SQUEEZY_WEBHOOK_SECRET: shared secret used to verify Lemon Squeezy webhook signatures.
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Billing (Razorpay - used when `stores.billingProvider = "razorpay"`)
# RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET: server-side API credentials.
# RAZORPAY_WEBHOOK_SECRET: shared secret to verify Razorpay webhooks.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_ID: monthly subscription plan id created in Razorpay dashboard.
RAZORPAY_PLAN_ID=

