# Frontend environment
# Copy to dashboard/.env and fill in values.

VITE_API_BASE_URL=https://us-central1-metricmango-9f621.cloudfunctions.net/api

# Firebase Authentication (Email + Password)
# Use Firebase Web SDK client keys only. Never put service-account/admin keys in frontend env files.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
