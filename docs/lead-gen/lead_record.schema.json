{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metric Mango Lead Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lead_id",
    "company_name",
    "domain",
    "shopify_detected",
    "source_name",
    "source_url",
    "collected_at_utc",
    "status"
  ],
  "properties": {
    "lead_id": { "type": "string", "pattern": "^LD-[0-9]{4,}$" },
    "company_name": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 3 },
    "shopify_detected": { "type": "string", "enum": ["yes", "no", "unknown"] },
    "industry": { "type": "string" },
    "country": { "type": "string" },
    "city": { "type": "string" },
    "employee_range": { "type": "string" },
    "monthly_orders_estimate": { "type": "string" },
    "inventory_signal": { "type": "string" },
    "growth_signal": { "type": "string" },
    "pain_signal": { "type": "string" },
    "decision_maker_name": { "type": "string" },
    "decision_maker_role": { "type": "string" },
    "contact_email": { "type": "string" },
    "linkedin_url": { "type": "string" },
    "source_name": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "minLength": 5 },
    "collected_at_utc": { "type": "string", "format": "date-time" },
    "qualification_score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
    "qualification_tier": { "type": "string", "enum": ["high", "medium", "low", "unqualified", ""] },
    "qualification_reason": { "type": "string" },
    "outreach_angle": { "type": "string" },
    "first_line": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "enriched",
        "qualified",
        "contacted",
        "replied",
        "meeting_booked",
        "closed_won",
        "closed_lost",
        "do_not_contact"
      ]
    },
    "next_action": { "type": "string" },
    "owner": { "type": "string" },
    "notes": { "type": "string" }
  }
}
